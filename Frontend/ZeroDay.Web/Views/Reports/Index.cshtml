@model JsonElement
@{
  ViewData["Title"] = "Reports";
  var preds = (JsonElement)ViewData["Predictions"]!;
}
<h2 class="mb-3">Reports</h2>
@if (User.IsInRole("Admin") || User.IsInRole("Analyst"))
{
<div class="card mb-4"><div class="card-body">
  <form method="post" asp-action="Create" class="row g-2 align-items-end">
    <div class="col-md-5"><label class="form-label">Analysis</label><select name="predictionId" class="form-select" required>
      <option value="">Choose an analysis...</option>
      @foreach (var p in preds.A("items")) { <option value="@p.S("id")">#@p.S("id") - @p.S("dataset") (@p.P("summary").L("threats") threats)</option> }
    </select></div>
    <div class="col-md-3"><label class="form-label">Type</label><select name="type" class="form-select"><option>Threat</option><option>Risk</option></select></div>
    <div class="col-md-2"><button class="btn btn-danger w-100">Generate</button></div>
  </form>
</div></div>
}
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
  <thead><tr><th>#</th><th>Title</th><th>Type</th><th>Created</th><th></th></tr></thead><tbody>
  @foreach (var r in Model.A("items"))
  { <tr><td>@r.S("id")</td><td>@r.S("title")</td><td><span class="badge bg-secondary">@r.S("type")</span></td><td class="small">@r.S("createdAt")</td>
        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Pdf" asp-route-id="@r.S("id")"><i class="bi bi-file-earmark-pdf"></i> PDF</a></td></tr> }
  @if (!Model.A("items").Any()) { <tr><td colspan="5" class="text-center text-secondary py-4">No reports yet.</td></tr> }
</tbody></table></div></div>
