@{ ViewData["Title"] = "Sign in"; }
<div class="auth-card card shadow"><div class="card-body p-4">
  <h3 class="mb-1"><i class="bi bi-shield-lock-fill text-danger"></i> ZeroDay Shield</h3>
  <p class="text-secondary">Zero-day network attack detection</p>
  @if (ViewData["Error"] is string e) { <div class="alert alert-danger">@e</div> }
  <form method="post" asp-action="Login">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required autofocus /></div>
    <div class="mb-3"><label class="form-label">Password</label><input name="password" type="password" class="form-control" required /></div>
    <button class="btn btn-danger w-100">Sign in</button>
  </form>
  <div class="d-flex justify-content-between mt-3 small">
    <a asp-action="Forgot">Forgot password?</a><a asp-action="Register">Create account</a>
  </div>
</div></div>
