@{ ViewData["Title"] = "Forgot password"; }
<div class="auth-card card shadow"><div class="card-body p-4">
  <h3 class="mb-3">Forgot password</h3>
  @if (ViewData["Error"] is string e) { <div class="alert alert-danger">@e</div> }
  <form method="post" asp-action="Forgot">
    <div class="mb-3"><label class="form-label">Account email</label><input name="email" type="email" class="form-control" required /></div>
    <button class="btn btn-danger w-100">Request reset</button>
  </form>
  <div class="mt-3 small"><a asp-action="Login">Back to sign in</a></div>
</div></div>
